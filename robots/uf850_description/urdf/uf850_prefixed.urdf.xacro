<?xml version="1.0"?>
<robot name="uf850_robot_prefab" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro params -->
  <xacro:macro name="uf850_robot" params="
      prefix
      mesh_pkg:='uf850_description'
      mesh_subdir:='meshes/visual'
      color_primary:='0.82 0.82 0.82 1.0'
      color_secondary:='0.70 0.72 0.75 1.0'
  ">
    <xacro:property name="mesh_prefix" value="package://${mesh_pkg}/${mesh_subdir}"/>

    <!-- Prefix-scoped materials (unique per robot) -->
    <material name="${prefix}mat_primary"><color rgba="${color_primary}"/></material>
    <material name="${prefix}mat_secondary"><color rgba="${color_secondary}"/></material>

    <!-- ============== base_link ============== -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link_base.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link_base.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00025599 -0.0000028579 0.085749" rpy="0 0 0"/>
        <mass value="2.2684"/>
        <inertia ixx="0.0063949"  ixy="-8.0653e-07" ixz="-2.1841e-05"
                 iyy="0.0064375"  iyz="-4.2181e-07" izz="0.0048631"/>
      </inertial>
    </link>

    <!-- ============== link1 / joint1 ============== -->
    <link name="${prefix}link1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}link1"/>
      <origin xyz="0 0 0.364" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="200.0" velocity="3.14"/>
      <dynamics damping="16.6" friction="9.6"/>
    </joint>

    <!-- ============== link2 / joint2 ============== -->
    <link name="${prefix}link2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child  link="${prefix}link2"/>
      <origin xyz="0 0 0" rpy="1.5708 -1.5708 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.3038346" upper="2.3038346" effort="200.0" velocity="3.14"/>
      <dynamics damping="12.5" friction="12.1"/>
    </joint>

    <!-- ============== link3 / joint3 ============== -->
    <link name="${prefix}link3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.9"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child  link="${prefix}link3"/>
      <origin xyz="0.39 0 0" rpy="-3.1416 0 -1.5708"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.2236968" upper="0.061087" effort="90.0" velocity="3.14"/>
      <dynamics damping="4.0" friction="5.5"/>
    </joint>

    <!-- ============== link4 / joint4 ============== -->
    <link name="${prefix}link4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0017" iyz="0" izz="0.0017"/>
      </inertial>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child  link="${prefix}link4"/>
      <origin xyz="0.15 0.426 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="68.0" velocity="3.14"/>
      <dynamics damping="3.6" friction="2.2"/>
    </joint>

    <!-- ============== link5 / joint5 ============== -->
    <link name="${prefix}link5">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.6"/>
        <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/>
      </inertial>
    </link>

    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child  link="${prefix}link5"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.1642" upper="2.1642" effort="19.0" velocity="3.14"/>
      <dynamics damping="3.45" friction="3.2"/>
    </joint>

    <!-- ============== link6 / joint6 ============== -->
    <link name="${prefix}link6">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link6.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link6.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
      </inertial>
    </link>

    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child  link="${prefix}link6"/>
      <origin xyz="0 -0.09 0" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="19.0" velocity="3.14"/>
      <dynamics damping="3.4" friction="1.1"/>
    </joint>

    <!-- Optional TCP -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}tool0_fixed" type="fixed">
      <parent link="${prefix}link6"/>
      <child  link="${prefix}tool0"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
