<?xml version="1.0"?>
<robot name="uf850" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameters -->
  <xacro:arg name="mesh_pkg" default="uf850_description"/>
  <xacro:arg name="mesh_subdir" default="meshes/visual"/>
  <xacro:property name="mesh_prefix" value="package://$(arg mesh_pkg)/$(arg mesh_subdir)"/>

  <!-- Materials -->
  <material name="mat_white">
    <color rgba="0.82 0.82 0.82 1"/>
  </material>

  <!-- ================= -->
  <!-- base_link         -->
  <!-- ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/link_base.stl"/>
      </geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/link_base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00025599 -0.0000028579 0.085749" rpy="0 0 0"/>
      <mass value="2.2684"/>
      <inertia
        ixx="0.0063949"  ixy="-8.0653e-07" ixz="-2.1841e-05"
        iyy="0.0064375"  iyz="-4.2181e-07" izz="0.0048631"/>
    </inertial>
  </link>

  <!-- ================= -->
  <!-- link1 & joint1    -->
  <!-- ================= -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child  link="link1"/>
    <origin xyz="0 0 0.364" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="200.0" velocity="3.14"/>
    <dynamics damping="16.6" friction="9.6"/>
  </joint>

  <!-- ================= -->
  <!-- link2 & joint2    -->
  <!-- ================= -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child  link="link2"/>
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.3038346" upper="2.3038346" effort="200.0" velocity="3.14"/>
    <dynamics damping="12.5" friction="12.1"/>
  </joint>

  <!-- ================= -->
  <!-- link3 & joint3    -->
  <!-- ================= -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child  link="link3"/>
    <origin xyz="0.39 0 0" rpy="-3.1416 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-4.2236968" upper="0.061087" effort="90.0" velocity="3.14"/>
    <dynamics damping="4.0" friction="5.5"/>
  </joint>

  <!-- ================= -->
  <!-- link4 & joint4    -->
  <!-- ================= -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0017" iyz="0" izz="0.0017"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child  link="link4"/>
    <origin xyz="0.15 0.426 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="68.0" velocity="3.14"/>
    <dynamics damping="3.6" friction="2.2"/>
  </joint>

  <!-- ================= -->
  <!-- link5 & joint5    -->
  <!-- ================= -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child  link="link5"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1642" upper="2.1642" effort="19.0" velocity="3.14"/>
    <dynamics damping="3.45" friction="3.2"/>
  </joint>

  <!-- ================= -->
  <!-- link6 & joint6    -->
  <!-- ================= -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link6.stl"/></geometry>
      <material name="mat_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_prefix}/link6.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child  link="link6"/>
    <origin xyz="0 -0.09 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="19.0" velocity="3.14"/>
    <dynamics damping="3.4" friction="1.1"/>
  </joint>

  <!-- Optional TCP frame -->
  <link name="tool0"/>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link6"/>
    <child  link="tool0"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

</robot>
