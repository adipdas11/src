<?xml version="1.0"?>
<robot name="xarm5_robot_prefab" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro with prefix + color params -->
  <xacro:macro name="xarm5_robot" params="
      prefix
      mesh_pkg:='xarm5_description'
      mesh_subdir:='meshes/visual'
      color_primary:='0.82 0.82 0.82 1.0'
      color_secondary:='0.70 0.72 0.75 1.0'
  ">
    <xacro:property name="mesh_prefix" value="package://${mesh_pkg}/${mesh_subdir}"/>

    <!-- Prefix-scoped, configurable materials (no global collisions) -->
    <material name="${prefix}mat_primary"><color rgba="${color_primary}"/></material>
    <material name="${prefix}mat_secondary"><color rgba="${color_secondary}"/></material>

    <!-- ===================== base_link ===================== -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link_base.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link_base.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00218 -0.00023 0.08604" rpy="0 0 0"/>
        <mass value="1.95"/>
        <inertia ixx="0.004805" ixy="-8.33e-06" ixz="0.00026847"
                 iyy="0.0050349" iyz="7.23e-06" izz="0.0025418"/>
      </inertial>
    </link>

    <!-- ===================== link1 / joint1 ===================== -->
    <link name="${prefix}link1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link1.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00013 0.0294 -0.01239" rpy="0 0 0"/>
        <mass value="2.3849"/>
        <inertia ixx="0.005705" ixy="1.056e-05" ixz="-2.642e-05"
                 iyy="0.00489488" iyz="-0.000890795" izz="0.00334846"/>
      </inertial>
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <origin xyz="0 0 0.267" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="50" velocity="3.14"/>
      <dynamics damping="10" friction="1"/>
    </joint>

    <!-- ===================== link2 / joint2 ===================== -->
    <link name="${prefix}link2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
        <material name="${prefix}mat_secondary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link2.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00071 0.01973 0.00456" rpy="0 0 0"/>
        <mass value="2.3849"/>
        <inertia ixx="0.005705" ixy="1.056e-05" ixz="-2.642e-05"
                 iyy="0.00489488" iyz="-0.000890795" izz="0.00334846"/>
      </inertial>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <parent link="${prefix}link1"/>
      <child  link="${prefix}link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.059" upper="2.0944" effort="50" velocity="3.14"/>
      <dynamics damping="10" friction="1"/>
    </joint>

    <!-- ===================== link3 / joint3 ===================== -->
    <link name="${prefix}link3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
        <material name="${prefix}mat_primary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link3.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00821 -0.01013 0.04328" rpy="0 0 0"/>
        <mass value="2.0082"/>
        <inertia ixx="0.003957" ixy="-0.0001027" ixz="-0.0002341"
                 iyy="0.0032811" iyz="-2.667e-05" izz="0.0029133"/>
      </inertial>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <origin xyz="0.0535 -0.2845 0" rpy="0 0 0"/>
      <parent link="${prefix}link2"/>
      <child  link="${prefix}link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.927" upper="0.19198" effort="30" velocity="3.14"/>
      <dynamics damping="5" friction="1"/>
    </joint>

    <!-- ===================== link4 / joint4 ===================== -->
    <link name="${prefix}link4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
        <material name="${prefix}mat_secondary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link4.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00044 -0.00335 0.03164" rpy="0 0 0"/>
        <mass value="0.9599"/>
        <inertia ixx="0.0011154" ixy="-4.32e-05" ixz="-6.08e-05"
                 iyy="0.0009913" iyz="-6.09e-06" izz="0.0007319"/>
      </inertial>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <!-- FIXED to match your reference URDF -->
      <origin xyz="0.0775 0.3425 0" rpy="0 0 0"/>
      <parent link="${prefix}link3"/>
      <child  link="${prefix}link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.69297" upper="3.141592653589793" effort="20" velocity="3.14"/>
      <dynamics damping="3" friction="1"/>
    </joint>

    <!-- ===================== link5 / joint5 ===================== -->
    <link name="${prefix}link5">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
        <material name="${prefix}mat_secondary"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/link5.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00121 -0.00085 0.02196" rpy="0 0 0"/>
        <mass value="0.727"/>
        <inertia ixx="0.0003185" ixy="-1.78e-05" ixz="-6.2e-06"
                 iyy="0.0002603" iyz="1.72e-06" izz="0.0002789"/>
      </inertial>
    </link>

    <joint name="${prefix}joint5" type="revolute">
      <!-- FIXED to match your reference URDF -->
      <origin xyz="0.076 0.097 0" rpy="-1.5708 0 0"/>
      <parent link="${prefix}link4"/>
      <child  link="${prefix}link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="3.14"/>
      <dynamics damping="3" friction="1"/>
    </joint>

    <!-- ===================== TCP helper ===================== -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}tool0_fixed" type="fixed">
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <parent link="${prefix}link5"/>
      <child  link="${prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
