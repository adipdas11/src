<?xml version="1.0"?>
<robot name="xarm5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Top-level args -->
  <xacro:arg name="prefix" default="x1_"/>
  <xacro:arg name="mesh_pkg" default="xarm5_description"/>
  <xacro:arg name="mesh_subdir" default="meshes/visual"/>

  <!-- Include prefab + instantiate -->
  <xacro:include filename="$(find xarm5_description)/urdf/xarm5_prefixed.urdf.xacro"/>

  <xacro:xarm5_robot
      prefix="$(arg prefix)"
      mesh_pkg="$(arg mesh_pkg)"
      mesh_subdir="$(arg mesh_subdir)"
      color_primary="0.30 0.45 0.95 1.0"
      color_secondary="0.15 0.20 0.35 1.0"/>
</robot>
